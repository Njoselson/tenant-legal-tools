- id: heap_application
  name: HEAP Application for Cooling Assistance
  description: An application to the Home Energy Assistance Program (HEAP) for financial
    assistance with the purchase, installation, and electrical costs of cooling an
    apartment.
  jurisdiction: NYS
  status: proposed
  aliases: &id015 []
  _bootstrap:
    sources:
    - https://www.justfix.org/en/learn/air-conditioning-laws
    sample_quotes:
