# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.env
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/

# Logs
logs/
*.log

# Local development
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ingestion artifacts (keep manifests, ignore generated files)
data/archive/
data/*_checkpoint.json
data/*_report.json
data/*_stats.json
data/analysis_cache.sqlite
data/extraction_tests/
data/retrieval_test_results.json
data/*.graphml

# Keep manifests version controlled (whitelist pattern)
!data/manifests/
!data/manifests/**/*.jsonl
!data/manifests/**/*.md 

# Spec-kit and agentic files
.specify/
.cursor/
.gitnexus

# GitNexus reinstalls its skills into the project on every `analyze` run.
# The canonical copies are global (~/.claude/skills -> Obsidian vault), so
# ignore the per-repo duplicates rather than tracking them.
# Use `gitnexus analyze --skip-skills` to avoid creating them at all.
.claude/skills/gitnexus-*/
